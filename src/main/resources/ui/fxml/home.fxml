<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<BorderPane
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="io.github.danielcampossantos.ui.home.HomeController"
        styleClass="home-root">

    <stylesheets>
        <URL value="@../css/home.css"/>
    </stylesheets>

    <left>
        <VBox
                alignment="TOP_CENTER"
                prefWidth="78"
                minWidth="78"
                maxWidth="78"
                styleClass="home-sidebar">

            <padding>
                <Insets top="18" right="10" bottom="14" left="10"/>
            </padding>


            <Region VBox.vgrow="ALWAYS"/>

            <Button
                    fx:id="settingsButton"
                    onAction="#onOpenSettings"
                    styleClass="settings-button"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20">

            <padding>
                <Insets top="28" right="32" bottom="28" left="32"/>
            </padding>

            <VBox spacing="6">
                <Label
                        text="Importar documentos"
                        styleClass="home-title"/>

                <Label
                        text="Adicione os arquivos PDF que serão utilizados para montar a apresentação."
                        styleClass="home-subtitle"/>
            </VBox>

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="12"
                    styleClass="template-status-panel">

                <Label
                        fx:id="templateStatusLabel"
                        text="Configure um template para continuar"
                        styleClass="template-status-label"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        text="Abrir configurações"
                        onAction="#onOpenSettings"
                        styleClass="template-settings-link"/>
            </HBox>

            <StackPane
                    fx:id="dropArea"
                    VBox.vgrow="ALWAYS"
                    styleClass="drop-area"
                    onDragEntered="#onDragEntered"
                    onDragExited="#onDragExited"
                    onDragOver="#onDragOver"
                    onDragDropped="#onDragDropped">

                <VBox
                        alignment="CENTER"
                        spacing="12">

                    <Label
                            text="Adicionar arquivos PDF"
                            styleClass="drop-title"/>

                    <Label
                            text="Arraste os arquivos para esta área ou selecione manualmente."
                            styleClass="drop-description"/>

                    <Button
                            text="Selecionar PDFs"
                            onAction="#onSelectPdf"
                            styleClass="select-pdf-button"/>
                </VBox>
            </StackPane>

            <HBox alignment="CENTER_LEFT" spacing="14">

                <Label
                        fx:id="pdfCounterLabel"
                        text="Nenhum PDF selecionado"
                        styleClass="pdf-counter"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        fx:id="clearSelectionButton"
                        text="Limpar seleção"
                        onAction="#onClearSelection"
                        styleClass="secondary-button"/>

                <Button
                        fx:id="continueButton"
                        text="Continuar"
                        onAction="#onContinue"
                        styleClass="primary-button"/>
            </HBox>

            <ListView
                    fx:id="pdfListView"
                    prefHeight="210"
                    minHeight="140"
                    styleClass="pdf-list"/>

        </VBox>
    </center>

</BorderPane>