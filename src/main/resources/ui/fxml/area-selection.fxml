<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TreeView?>
<BorderPane
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="io.github.danielcampossantos.ui.controller.AreaSelectionController">

    <stylesheets>

        <URL value="@../css/area-selection.css"/>

    </stylesheets>

    <padding>

        <Insets top="24"
                right="24"
                bottom="24"
                left="24"/>

    </padding>

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20">

            <VBox spacing="6">

                <Label
                        text="Seleção de Áreas"
                        styleClass="title"/>

                <Label
                        text="Selecione uma região em cada página do PDF. As coordenadas serão utilizadas para gerar automaticamente o arquivo de configuração."
                        styleClass="subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button
                    fx:id="backButton"
                    text="Voltar"
                    styleClass="secondary-button"
                    onAction="#onBack"/>

            <Button
                    fx:id="finishButton"
                    text="Finalizar"
                    styleClass="primary-button"
                    onAction="#onFinish"/>

        </HBox>

    </top>

    <center>

        <HBox
                spacing="24"
                BorderPane.alignment="CENTER">

            <StackPane
                    HBox.hgrow="ALWAYS"
                    styleClass="viewer-container">

                <ScrollPane
                        fx:id="pagesScrollPane"
                        fitToWidth="true"
                        pannable="false"
                        styleClass="viewer-scroll">

                    <content>

                        <?import javafx.geometry.Insets?>

                        <VBox
                                fx:id="pagesContainer"
                                alignment="TOP_CENTER"
                                spacing="32">

                            <padding>

                                <Insets
                                        top="20"
                                        right="20"
                                        bottom="20"
                                        left="20"/>

                            </padding>

                        </VBox>

                    </content>

                </ScrollPane>

            </StackPane>

            <VBox
                    spacing="18"
                    prefWidth="340"
                    minWidth="340"
                    maxWidth="340"
                    styleClass="sidebar">

                <Label
                        text="Áreas Selecionadas"
                        styleClass="sidebar-title"/>

                <Label
                        fx:id="selectionCounter"
                        text="0 áreas selecionadas"
                        styleClass="selection-counter"/>

                <TreeView
                        fx:id="selectionTreeView"
                        showRoot="false"
                        VBox.vgrow="ALWAYS"/>

            </VBox>

        </HBox>

    </center>

</BorderPane>