<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        fx:id="rootPane"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="io.github.danielcampossantos.ui.controller.PresentationPreviewController"
        styleClass="presentation-preview-root">

    <stylesheets>
        <URL value="@../css/presentation-preview.css"/>
    </stylesheets>

    <BorderPane>

        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <top>

            <VBox spacing="18">

                <HBox alignment="CENTER_LEFT" spacing="18">

                    <VBox spacing="6">

                        <Label
                                text="Montagem da apresentação"
                                styleClass="presentation-title"/>

                        <Label
                                text="Revise os slides que serão incluídos na versão final do PowerPoint."
                                styleClass="presentation-subtitle"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button
                            text="Voltar"
                            styleClass="secondary-button"
                            onAction="#onBack"/>

                    <Button
                            fx:id="finishButton"
                            text="Gerar apresentação"
                            styleClass="primary-button"
                            onAction="#onFinish"/>

                </HBox>

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="18"
                        styleClass="template-panel">

                    <VBox
                            alignment="CENTER"
                            styleClass="template-icon-container">

                        <Label
                                text="P"
                                styleClass="template-icon"/>

                    </VBox>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">

                        <Label
                                text="Template do PowerPoint"
                                styleClass="template-label"/>

                        <Label
                                fx:id="templateNameLabel"
                                text="Nenhum template selecionado"
                                styleClass="template-name"/>

                        <Label
                                fx:id="templatePathLabel"
                                text="Selecione um arquivo PowerPoint para continuar."
                                styleClass="template-path"/>

                    </VBox>

                    <Button
                            fx:id="changeTemplateButton"
                            text="Selecionar template"
                            styleClass="template-button"
                            onAction="#onChooseTemplate"/>

                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12">

                    <Label
                            fx:id="slideCounterLabel"
                            text="0 slides na apresentação"
                            styleClass="preview-counter"/>

                    <Label
                            text="•"
                            styleClass="preview-counter-separator"/>

                    <Label
                            fx:id="cropCounterLabel"
                            text="0 imagens processadas"
                            styleClass="preview-counter-secondary"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label
                            text="Ctrl + Z para desfazer"
                            styleClass="shortcut-label"/>

                    <Button
                            fx:id="undoButton"
                            text="Desfazer exclusões"
                            styleClass="undo-button"
                            onAction="#onUndoAll"/>

                </HBox>

            </VBox>

        </top>

        <center>

            <StackPane
                    BorderPane.alignment="CENTER"
                    styleClass="slides-viewer">

                <ScrollPane
                        fx:id="slidesScrollPane"
                        fitToWidth="true"
                        pannable="false"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="slides-scroll-pane">

                    <content>

                        <StackPane>

                            <VBox
                                    fx:id="slidesContainer"
                                    alignment="TOP_CENTER"
                                    spacing="22">

                                <padding>
                                    <Insets top="24" right="24" bottom="34" left="24"/>
                                </padding>

                            </VBox>

                            <VBox
                                    fx:id="emptyState"
                                    alignment="CENTER"
                                    spacing="12"
                                    visible="false"
                                    managed="false"
                                    styleClass="empty-slides-state">

                                <Label
                                        text="Nenhum slide na apresentação"
                                        styleClass="empty-slides-title"/>

                                <Label
                                        text="Use Ctrl + Z ou o botão Desfazer exclusão para restaurar o último slide removido."
                                        wrapText="true"
                                        styleClass="empty-slides-description"/>

                            </VBox>

                        </StackPane>

                    </content>

                </ScrollPane>

            </StackPane>

        </center>

        <BorderPane.margin>
            <Insets top="0" right="0" bottom="0" left="0"/>
        </BorderPane.margin>

    </BorderPane>

</StackPane>