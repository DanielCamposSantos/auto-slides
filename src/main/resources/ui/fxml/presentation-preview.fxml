<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<StackPane
        fx:id="rootPane"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="io.github.danielcampossantos.ui.preview.PresentationPreviewController"
        styleClass="presentation-preview-root">

    <stylesheets>
        <URL value="@../css/presentation-preview.css"/>
    </stylesheets>

    <BorderPane>

        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <top>
            <VBox spacing="18">

                <HBox alignment="CENTER_LEFT" spacing="18">

                    <VBox spacing="6">
                        <Label
                                text="Montagem da apresentação"
                                styleClass="presentation-title"/>

                        <Label
                                text="Revise os slides do template que serão incluídos na apresentação final."
                                styleClass="presentation-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button
                            text="Voltar"
                            styleClass="secondary-button"
                            onAction="#onBack"/>

                    <Button
                            fx:id="finishButton"
                            text="Baixar apresentação"
                            styleClass="primary-button"
                            onAction="#onFinish"/>
                </HBox>

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="18"
                        styleClass="template-panel">

                    <VBox
                            alignment="CENTER"
                            styleClass="template-icon-container">

                        <Label
                                text="P"
                                styleClass="template-icon"/>
                    </VBox>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">

                        <Label
                                text="Template configurado"
                                styleClass="template-label"/>

                        <Label
                                fx:id="templateNameLabel"
                                styleClass="template-name"/>

                        <Label
                                fx:id="templatePathLabel"
                                styleClass="template-path"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12">

                    <Label
                            fx:id="slideCounterLabel"
                            text="0 slides na apresentação"
                            styleClass="preview-counter"/>

                    <Label
                            text="•"
                            styleClass="preview-counter-separator"/>

                    <Label
                            fx:id="cropCounterLabel"
                            text="0 imagens processadas"
                            styleClass="preview-counter-secondary"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label
                            text="Ctrl + Z para desfazer"
                            styleClass="shortcut-label"/>

                    <Button
                            fx:id="undoButton"
                            text="Desfazer"
                            styleClass="undo-button"
                            onAction="#onUndo"/>

                    <Button
                            fx:id="undoAllButton"
                            text="Restaurar todos"
                            styleClass="undo-button"
                            onAction="#onUndoAll"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <StackPane
                    BorderPane.alignment="CENTER"
                    styleClass="slides-viewer">

                <ScrollPane
                        fitToWidth="true"
                        pannable="false"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="slides-scroll-pane">

                    <content>
                        <StackPane>

                            <VBox
                                    fx:id="slidesContainer"
                                    alignment="TOP_CENTER"
                                    spacing="22">

                                <padding>
                                    <Insets top="24" right="24" bottom="34" left="24"/>
                                </padding>
                            </VBox>

                            <VBox
                                    fx:id="emptyState"
                                    alignment="CENTER"
                                    spacing="12"
                                    visible="false"
                                    managed="false"
                                    styleClass="empty-slides-state">

                                <Label
                                        text="Nenhum slide na apresentação"
                                        styleClass="empty-slides-title"/>

                                <Label
                                        text="Use Ctrl + Z, Desfazer ou Restaurar todos para recuperar os slides removidos."
                                        wrapText="true"
                                        styleClass="empty-slides-description"/>
                            </VBox>
                        </StackPane>
                    </content>
                </ScrollPane>
            </StackPane>
        </center>

    </BorderPane>

</StackPane>